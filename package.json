{
  "name": "ubiquiti-api-companion",
  "version": "0.1.0",
  "description": "The Ultimate Ubiquiti API Companion - A comprehensive OpenAPI specification for all Ubiquiti products",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "update-specs": "node scripts/update-specs.js",
    "generate-clients": "node scripts/generate-clients.js",
    "docs": "typedoc src/index.ts",
    "build:examples": "tsc -p examples/tsconfig.json",
    "example:network": "ts-node examples/network-example.ts",
    "example:protect": "ts-node examples/protect-example.ts",
    "example:generated": "ts-node examples/generated-client-example.ts",
    "analyze-device": "node scripts/analyze-device-api.js",
    "monitor-firmware": "node scripts/firmware-monitor.js",
    "init-config": "cp scripts/config.sample.json scripts/config.json && echo 'Config file created at scripts/config.json'",
    "setup-github": "scripts/setup-github.sh"
  },
  "keywords": [
    "ubiquiti",
    "unifi",
    "unifi-protect",
    "unifi-access",
    "unifi-network",
    "api",
    "openapi",
    "swagger"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielborrowman/ubiquiti-api-companion.git"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "openapi-typescript-codegen": "^0.25.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.25.3",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "directories": {
    "doc": "docs"
  },
  "bugs": {
    "url": "https://github.com/danielborrowman/ubiquiti-api-companion/issues"
  },
  "homepage": "https://github.com/danielborrowman/ubiquiti-api-companion#readme"
}
